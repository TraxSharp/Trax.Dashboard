@page "/trax/data/manifests"
@using Trax.Scheduler.Services.TraxScheduler
@inherits PollingComponentBase
@inject IDataContextProviderFactory DataContextFactory
@inject NavigationManager Navigation
@inject ITraxScheduler Scheduler
@inject NotificationService NotificationService
@inject Trax.Scheduler.Services.Operations.IOperationsService OperationsService

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-2">Manifests</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" class="rz-mb-4" Style="color: var(--rz-text-secondary-color);">
    Scheduled train definitions with their scheduling configuration, retry policies, and execution history.
</RadzenText>

<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-3">
    @if (_selectedManifests.Count > 0)
    {
        <RadzenButton Text="@($"Trigger Selected ({_selectedManifests.Count})")"
                      Icon="play_arrow"
                      ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Small"
                      Disabled="@(BatchOperating)"
                      Click="@TriggerSelected" />
        <RadzenButton Text="@($"Enable Selected ({_selectedManifests.Count})")"
                      Icon="check_circle"
                      ButtonStyle="ButtonStyle.Success"
                      Variant="Variant.Outlined"
                      Size="ButtonSize.Small"
                      Disabled="@(BatchOperating)"
                      Click="@(() => SetSelectedEnabled(true))" />
        <RadzenButton Text="@($"Disable Selected ({_selectedManifests.Count})")"
                      Icon="block"
                      ButtonStyle="ButtonStyle.Danger"
                      Variant="Variant.Outlined"
                      Size="ButtonSize.Small"
                      Disabled="@(BatchOperating)"
                      Click="@(() => SetSelectedEnabled(false))" />
    }
</RadzenStack>

@if (BatchError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" class="rz-mb-3">@BatchError</RadzenAlert>
}

<TraxDataGrid @ref="_grid"
              TItem="Manifest"
              ServerLoadData="@LoadPageAsync">
    <Columns>
        <RadzenDataGridColumn TItem="Manifest"
                              Width="40px"
                              Sortable="false"
                              Filterable="false"
                              Frozen="true">
            <Template Context="m">
                <RadzenCheckBox TValue="bool"
                                Value="@(_selectedManifests.ContainsKey(m.Id))"
                                Change="@(args => { if ((bool)args!) _selectedManifests[m.Id] = m; else _selectedManifests.Remove(m.Id); PausePolling = _selectedManifests.Count > 0; })" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Manifest"
                              Title=""
                              Width="50px"
                              Sortable="false"
                              Filterable="false"
                              Frozen="true"
                              TextAlign="TextAlign.Center">
            <Template Context="m">
                <RadzenButton Icon="visibility"
                              Variant="Variant.Text"
                              Size="ButtonSize.Small"
                              Click="@(() => Navigation.NavigateTo($"trax/data/manifests/{m.Id}"))" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Manifest"
                              Property="Id"
                              Title="Id"
                              Width="80px"
                              SortOrder="SortOrder.Descending" />
        <RadzenDataGridColumn TItem="Manifest"
                              Property="Name"
                              Title="Name"
                              Width="250px">
            <Template Context="m">@ShortName(m.Name)</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="Manifest"
                              Property="ExternalId"
                              Title="External Id"
                              Width="200px"
                              Visible="false" />
        <RadzenDataGridColumn TItem="Manifest"
                              Property="ManifestGroup.Name"
                              Title="Group"
                              Width="180px" />
        <RadzenDataGridColumn TItem="Manifest"
                              Property="IsEnabled"
                              Title="Enabled"
                              Width="100px" />
        <RadzenDataGridColumn TItem="Manifest"
                              Property="ScheduleType"
                              Title="Schedule Type"
                              Width="150px" />
        <RadzenDataGridColumn TItem="Manifest"
                              Property="CronExpression"
                              Title="Cron Expression"
                              Width="170px"
                              Visible="false" />
        <RadzenDataGridColumn TItem="Manifest"
                              Property="IntervalSeconds"
                              Title="Interval (s)"
                              Width="130px"
                              Visible="false" />
        <RadzenDataGridColumn TItem="Manifest"
                              Property="MaxRetries"
                              Title="Max Retries"
                              Width="140px"
                              Visible="false" />
        <RadzenDataGridColumn TItem="Manifest"
                              Property="TimeoutSeconds"
                              Title="Timeout (s)"
                              Width="130px"
                              Visible="false" />
        <RadzenDataGridColumn TItem="Manifest"
                              Property="LastSuccessfulRun"
                              Title="Last Successful Run"
                              Width="200px"
                              FormatString="{0:yyyy-MM-dd HH:mm:ss}" />
    </Columns>
</TraxDataGrid>

@code {
    private TraxDataGrid<Manifest>? _grid;

    // Keyed by id: the grid reads a fresh page of manifests on every load, so a selection kept
    // by reference would stop matching the rows it was made on.
    private Dictionary<long, Manifest> _selectedManifests = [];

    private protected override async Task LoadDataAsync(CancellationToken cancellationToken)
    {
        if (_grid is not null)
            await _grid.ReloadAsync();
    }

    // One page at a time from the database, as the API's manifests query reads them.
    private Task<ServerDataResult<Manifest>> LoadPageAsync(LoadDataArgs args, CancellationToken ct)
        => DataGridQueryHelper.LoadPageAsync(
            DataContextFactory,
            db =>
            {
                IQueryable<Manifest> query = db.Manifests.Include(m => m.ManifestGroup).AsNoTracking();

                if (DashboardSettings.HideAdminTrains)
                    query = query.ExcludeAdmin(AdminTrains.FullNames);

                return query.OrderByDescending(m => m.Id);
            },
            args,
            ct
        );

    // One trigger per manifest, as the scheduler offers no batch trigger yet. Each is tried in
    // turn, so one that fails does not stop the rest. A manifest that already has a queued entry
    // gets nothing more queued: the scheduler marks that entry as the triggered run instead, so
    // it is reported apart from the manifests that were queued.
    private Task TriggerSelected() => RunEachAsync("Batch Trigger", async () =>
    {
        var selected = _selectedManifests.Values.ToList();
        var ids = selected.Select(m => m.Id).ToList();

        HashSet<long> hadEntry;
        using (var context = await DataContextFactory.CreateDbContextAsync(DisposalToken))
            hadEntry = (await context.WorkQueues
                .AsNoTracking()
                .Where(q => q.ManifestId != null && ids.Contains(q.ManifestId.Value) && q.Status == WorkQueueStatus.Queued)
                .Select(q => q.ManifestId!.Value)
                .ToListAsync(DisposalToken))
                .ToHashSet();

        var queued = 0;
        var alreadyQueued = 0;
        var failures = new List<string>();
        foreach (var manifest in selected)
        {
            try
            {
                await Scheduler.TriggerAsync(manifest.ExternalId, DisposalToken);
                if (hadEntry.Contains(manifest.Id))
                    alreadyQueued++;
                else
                    queued++;
            }
            catch (Exception ex) when (!DisposalToken.IsCancellationRequested)
            {
                failures.Add($"{ShortName(manifest.Name)} ({manifest.ExternalId}) was not triggered: {ex.Message}");
            }
        }

        var message = $"{queued} queued";
        if (alreadyQueued > 0)
            message += $", {alreadyQueued} already queued (that entry now runs as the trigger)";
        if (failures.Count > 0)
            message += $", {failures.Count} failed";
        return new EachOutcome(message + ".", failures);
    }, () => _selectedManifests.Clear());

    // Through the operations service, as the API's setManifestsEnabled is. Only manifests whose
    // flag differs are written, and the count says how many that was.
    private Task SetSelectedEnabled(bool enabled) => RunBatchOperationAsync(
        enabled ? "Manifests Enabled" : "Manifests Disabled",
        () => OperationsService.SetManifestsEnabledAsync(_selectedManifests.Keys.ToList(), enabled, DisposalToken),
        () => _selectedManifests.Clear());
}
